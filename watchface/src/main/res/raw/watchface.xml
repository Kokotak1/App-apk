<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Scene backgroundColor="#ff000000">
    <!-- The user's approved Pip-Boy / Vault Boy art, visible only while awake. -->
    <PartImage x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="background" />
    </PartImage>
    <!-- Minimalist energy-saving AOD face, never superimposed on normal dial. -->
    <PartImage x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Image resource="aod_background" />
    </PartImage>

    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="197" y="76" width="56" height="173" pivotX="0.5" pivotY="0.861272" />
      <MinuteHand resource="minute" x="202" y="57" width="46" height="190" pivotX="0.5" pivotY="0.884211" />
      <SecondHand resource="second" x="221" y="25" width="8" height="218" pivotX="0.5" pivotY="0.917431">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Sweep frequency="15" />
      </SecondHand>
    </AnalogClock>
    <PartImage x="215" y="215" width="20" height="20">
      <Image resource="center" />
    </PartImage>

    <!-- Live service counter in the empty red terminal on the left. -->
    <PartText x="87" y="117" width="167" height="87">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="76" weight="BOLD" color="#ffff1919">
          <Template><![CDATA[%d]]>
            <Parameter expression="round([YEAR] &lt; 2026 ? 80 : ([YEAR] &gt; 2027 ? 0 : clamp(80 - floor((([YEAR] == 2026 ? [DAY_OF_YEAR] - 322 : 43 + [DAY_OF_YEAR]) + 3) / 4), 0, 80)))"/>
          </Template>
        </Font>
      </Text>
    </PartText>
    <!-- Keep the same live count in AOD, less luminous to save power. -->
    <PartText x="85" y="131" width="280" height="85" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="70" weight="BOLD" color="#ff993434">
          <Template><![CDATA[%d]]>
            <Parameter expression="round([YEAR] &lt; 2026 ? 80 : ([YEAR] &gt; 2027 ? 0 : clamp(80 - floor((([YEAR] == 2026 ? [DAY_OF_YEAR] - 322 : 43 + [DAY_OF_YEAR]) + 3) / 4), 0, 80)))"/>
          </Template>
        </Font>
      </Text>
    </PartText>
    <!-- Ambient label, as awake label is already part of background bitmap. -->
    <PartText x="110" y="97" width="230" height="38" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="24" color="#ff999999"><![CDATA[ZBÝVÁ]]></Font>
      </Text>
    </PartText>

    <!-- Live calendar date in the empty lower metal plate. -->
    <PartText x="112" y="296" width="225" height="42">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="23" color="#fff5f5f5">
          <Template><![CDATA[%s.%s.%d]]>
            <Parameter expression="[DAY_Z]"/>
            <Parameter expression="[MONTH_Z]"/>
            <Parameter expression="[YEAR]"/>
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="108" y="294" width="235" height="44" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="22" color="#ff999999">
          <Template><![CDATA[%s.%s.%d]]>
            <Parameter expression="[DAY_Z]"/>
            <Parameter expression="[MONTH_Z]"/>
            <Parameter expression="[YEAR]"/>
          </Template>
        </Font>
      </Text>
    </PartText>
  </Scene>
</WatchFace>
