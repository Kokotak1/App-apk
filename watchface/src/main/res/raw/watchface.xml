<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Scene backgroundColor="#ff000000">
    <!-- ECO: ambient bitmap is not composed in normal interactive mode. -->
    <PartImage x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Image resource="aod_background" />
    </PartImage>
    <!-- The full Pip-Boy dial covers the AOD underlay while awake only. -->
    <PartImage x="0" y="0" width="450" height="450" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="background" />
    </PartImage>

    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="210" y="75" width="30" height="174" pivotX="0.5" pivotY="0.862069">
        <Variant mode="AMBIENT" target="alpha" value="110" />
      </HourHand>
      <MinuteHand resource="minute" x="213" y="47" width="24" height="194" pivotX="0.5" pivotY="0.917526">
        <Variant mode="AMBIENT" target="alpha" value="110" />
      </MinuteHand>
      <!-- ECO WITH SECONDS: one short step per second, never a 15 Hz sweep.
           The second hand is disabled in ambient mode. -->
      <SecondHand resource="second" x="222" y="35" width="6" height="213" pivotX="0.5" pivotY="0.892019">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Tick duration="0.05" strength="1.0" />
      </SecondHand>
    </AnalogClock>
    <PartImage x="217" y="217" width="16" height="16">
      <Variant mode="AMBIENT" target="alpha" value="110" />
      <Image resource="center" />
    </PartImage>

    <!-- Remaining completed-duty decrements until 2027-08-01 00:00 Prague local time.
         The event sequence is 2026-11-19 07:00, 2026-11-23 07:00,
         2026-11-27 07:00, ... , 2027-07-29 07:00 (64 events).
         DAYS_IN_2026 = 365; Nov 19 is day-of-year 323.
         From Jan 1 2027, the shifted day serial is 42 + DAY_OF_YEAR.
         Use HOUR_0_23 so the decrement occurs at 07:00, not midnight. -->
    <!-- 65 duty completions every four days at 07:00; FREE after
         Mon 2027-08-02 07:00 (first August duty). No visible zero. -->
    <Condition>
      <Expressions>
        <Expression name="freeReachedActive"><![CDATA[[YEAR] > 2027 || ([YEAR] == 2027 && ([DAY_OF_YEAR] > 214 || ([DAY_OF_YEAR] == 214 && [HOUR_0_23] >= 7)))]]></Expression>
      </Expressions>
      <Compare expression="freeReachedActive">
        <PartText x="79" y="131" width="193" height="87">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="60" weight="BOLD" color="#ffff1919">FREE</Font>
          </Text>
          <Launch target="cz.youarefree.pipboy.countdown7/cz.youarefree.pipboy.countdown.CountdownActivity" />
        </PartText>
      </Compare>
      <Default>
        <PartText x="89" y="122" width="167" height="87">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="76" weight="BOLD" color="#ffff1919">
              <Template><![CDATA[%d]]>
                <Parameter expression="round([YEAR] &lt; 2026 ? 65 : ([YEAR] &gt; 2027 ? 0 : clamp(65 - floor((([YEAR] == 2026 ? [DAY_OF_YEAR] - 323 : 42 + [DAY_OF_YEAR]) + ([HOUR_0_23] &gt;= 7 ? 4 : 3)) / 4), 0, 65)))"/>
              </Template>
            </Font>
          </Text>
          <Launch target="cz.youarefree.pipboy.countdown7/cz.youarefree.pipboy.countdown.CountdownActivity" />
        </PartText>
      </Default>
    </Condition>

    <!-- Same number / FREE switch in ambient mode. -->
    <Condition>
      <Expressions>
        <Expression name="freeReachedAmbient"><![CDATA[[YEAR] > 2027 || ([YEAR] == 2027 && ([DAY_OF_YEAR] > 214 || ([DAY_OF_YEAR] == 214 && [HOUR_0_23] >= 7)))]]></Expression>
      </Expressions>
      <Compare expression="freeReachedAmbient">
        <PartText x="85" y="132" width="280" height="85" alpha="0">
          <Variant mode="AMBIENT" target="alpha" value="255" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="53" weight="BOLD" color="#ff993434">FREE</Font>
          </Text>
        </PartText>
      </Compare>
      <Default>
        <PartText x="85" y="131" width="280" height="85" alpha="0">
          <Variant mode="AMBIENT" target="alpha" value="255" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="70" weight="BOLD" color="#ff993434">
              <Template><![CDATA[%d]]>
                <Parameter expression="round([YEAR] &lt; 2026 ? 65 : ([YEAR] &gt; 2027 ? 0 : clamp(65 - floor((([YEAR] == 2026 ? [DAY_OF_YEAR] - 323 : 42 + [DAY_OF_YEAR]) + ([HOUR_0_23] &gt;= 7 ? 4 : 3)) / 4), 0, 65)))"/>
              </Template>
            </Font>
          </Text>
        </PartText>
      </Default>
    </Condition>
    <!-- Ambient label, as awake label is already part of background bitmap. -->
    <PartText x="110" y="97" width="230" height="38" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="24" color="#ff999999"><![CDATA[ZBÝVÁ]]></Font>
      </Text>
    </PartText>

    <!-- Live, independently updated battery gauge in the Vault-Tec terminal.
         Five inlaid green charge segments, with a numerical percentage. -->
    <Condition>
      <Expressions>
        <Expression name="charge20"><![CDATA[[BATTERY_PERCENT] >= 20]]></Expression>
      </Expressions>
      <Compare expression="charge20">
        <PartDraw x="109" y="253" width="10" height="11">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Rectangle x="0" y="0" width="10" height="11"><Fill color="#ff27ec40" /></Rectangle>
        </PartDraw>
      </Compare>
    </Condition>
    <!-- Each threshold is a separate conditional, enabling a true charge gauge. -->
    <Condition>
      <Expressions><Expression name="c40"><![CDATA[[BATTERY_PERCENT] >= 40]]></Expression></Expressions>
      <Compare expression="c40"><PartDraw x="122" y="253" width="10" height="11">
        <Variant mode="AMBIENT" target="alpha" value="0" />
          <Rectangle x="0" y="0" width="10" height="11"><Fill color="#ff27ec40" /></Rectangle>
      </PartDraw></Compare>
    </Condition>
    <Condition>
      <Expressions><Expression name="c60"><![CDATA[[BATTERY_PERCENT] >= 60]]></Expression></Expressions>
      <Compare expression="c60"><PartDraw x="135" y="253" width="10" height="11">
        <Variant mode="AMBIENT" target="alpha" value="0" />
          <Rectangle x="0" y="0" width="10" height="11"><Fill color="#ff27ec40" /></Rectangle>
      </PartDraw></Compare>
    </Condition>
    <Condition>
      <Expressions><Expression name="c80"><![CDATA[[BATTERY_PERCENT] >= 80]]></Expression></Expressions>
      <Compare expression="c80"><PartDraw x="148" y="253" width="10" height="11">
        <Variant mode="AMBIENT" target="alpha" value="0" />
          <Rectangle x="0" y="0" width="10" height="11"><Fill color="#ff27ec40" /></Rectangle>
      </PartDraw></Compare>
    </Condition>
    <Condition>
      <Expressions><Expression name="c100"><![CDATA[[BATTERY_PERCENT] >= 100]]></Expression></Expressions>
      <Compare expression="c100"><PartDraw x="161" y="253" width="10" height="11">
        <Variant mode="AMBIENT" target="alpha" value="0" />
          <Rectangle x="0" y="0" width="10" height="11"><Fill color="#ff27ec40" /></Rectangle>
      </PartDraw></Compare>
    </Condition>
    <PartText x="104" y="264" width="85" height="27">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#ff34f451">
          <Template><![CDATA[%d%%]]>
            <Parameter expression="[BATTERY_PERCENT]"/>
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- Live calendar date in the empty lower metal plate, plus weekday. -->
    <PartText x="115" y="303" width="225" height="42">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="19" color="#fff5f5f5">
          <Template><![CDATA[%s  %s.%s.%d]]>
            <Parameter expression="[DAY_OF_WEEK_S]"/>
            <Parameter expression="[DAY_Z]"/>
            <Parameter expression="[MONTH_Z]"/>
            <Parameter expression="[YEAR]"/>
          </Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="108" y="294" width="235" height="44" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="19" color="#ff999999">
          <Template><![CDATA[%s  %s.%s.%d]]>
            <Parameter expression="[DAY_OF_WEEK_S]"/>
            <Parameter expression="[DAY_Z]"/>
            <Parameter expression="[MONTH_Z]"/>
            <Parameter expression="[YEAR]"/>
          </Template>
        </Font>
      </Text>
    </PartText>
  </Scene>
</WatchFace>
